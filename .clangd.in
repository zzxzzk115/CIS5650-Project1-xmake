CompileFlags:
  CompilationDatabase: .
  Remove: [-G, -gencode, 'arch=compute_*', '-rdc=*', -Xcompiler, -fPIE, --std, c++17, -lineinfo]
  Add: [-std=c++17, @CUDA_PATH@, --cuda-gpu-arch=@CUDA_ARCH@]
Completion:
  HeaderInsertion: Never
---
If:
  PathMatch: .*\.cu(h)?
CompileFlags:
  Compiler: clang++
  Add: [-xcuda]
