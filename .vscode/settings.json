{
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.enable": true,
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--header-insertion=never",
        "--fallback-style=none"
    ],
    "xmake.compileCommandsBackend": "clangd",
    "xmake.compileCommandsDirectory": ".",
    "xmake.autoGenerateCompileCommands": "disabled",
    "nsight.cuda.languageSupport.provider": "clangd",
    "nsight.cuda.languageSupport.autoConfigure": false,
    "better-todo-tree.languages.customPatterns": [
        {
            "id": "cuda",
            "name": "CUDA C++",
            "languageIds": [
                "cuda-cpp"
            ],
            "extensions": [
                ".cu",
                ".cuh"
            ],
            "singleLineComments": [
                "//"
            ],
            "multiLineComments": [
                {
                    "start": "/*",
                    "middle": "*",
                    "end": "*/"
                }
            ]
        }
    ]
}
