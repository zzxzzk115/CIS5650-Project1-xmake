{
    "folders": [
        {
            "name": "CIS5650 Project 1",
            "path": "."
        }
    ],
    "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.enable": true,
        "clangd.arguments": [
            "--compile-commands-dir=${workspaceFolder}",
            "--header-insertion=never",
            "--fallback-style=none"
        ],
        "xmake.compileCommandsBackend": "clangd",
        "xmake.compileCommandsDirectory": ".",
