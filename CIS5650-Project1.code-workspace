        "nsight.cuda.languageSupport.provider": "clangd",
        "nsight.cuda.languageSupport.autoConfigure": false,
        "workbench.colorCustomizations": {
            "activityBar.background": "#0F3328",
            "titleBar.activeBackground": "#164838",
            "titleBar.activeForeground": "#F5FCFA",
            "titleBar.inactiveBackground": "#0F3328",
            "titleBar.inactiveForeground": "#F5FCFA",
            "statusBar.background": "#0F3328",
            "statusBar.foreground": "#F5FCFA",
            "statusBar.debuggingBackground": "#0F3328",
            "statusBar.debuggingForeground": "#F5FCFA",
            "statusBar.noFolderBackground": "#0F3328",
            "statusBar.noFolderForeground": "#F5FCFA"
        }
    }
